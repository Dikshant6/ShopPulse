<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - ShopPulse</title>
    <meta name="description" content="Complete your purchase on ShopPulse. Review items, provide shipping address, and place your order securely.">
    <link rel="stylesheet" href="/css/checkout.css">
</head>

<body>

    <!-- Header & Navigation (Consistent with ShopPulse Design) -->
    <header class="app-header">
        <div class="header-container">
            <!-- Brand Logo -->
            <div class="brand-area">
                <a href="<%= (typeof user !== 'undefined' && user) ? '/dashboard' : '/products' %>" class="brand-logo"
                    aria-label="ShopPulse Home">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                            stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                    </div>
                    <span>ShopPulse</span>
                </a>
                <% if (typeof user !=='undefined' && user && user.role==='admin' ) { %>
                    <span class="admin-tag">Admin</span>
                <% } %>
            </div>

            <!-- Navigation Links -->
            <nav aria-label="Main Navigation">
                <ul class="nav-links">
                    <% if (typeof user !=='undefined' && user && user.role==='admin' ) { %>
                        <li class="nav-item"><a href="/dashboard">Dashboard</a></li>
                        <li class="nav-item"><a href="/products">Storefront</a></li>
                        <li class="nav-item"><a href="/admin/products">Products</a></li>
                    <% } else if (typeof user !=='undefined' && user) { %>
                        <li class="nav-item"><a href="/dashboard">Home</a></li>
                        <li class="nav-item"><a href="/products">Products</a></li>
                        <li class="nav-item"><a href="/wishlist">Wishlist</a></li>
                        <li class="nav-item"><a href="/orders">Orders</a></li>
                        <li class="nav-item"><a href="/cart" class="active">Cart</a></li>
                    <% } else { %>
                        <li class="nav-item"><a href="/products">Products</a></li>
                        <li class="nav-item"><a href="/wishlist">Wishlist</a></li>
                        <li class="nav-item"><a href="/cart" class="active">Cart</a></li>
                    <% } %>
                </ul>
            </nav>

            <!-- User Profile / Auth Area -->
            <div class="header-user-area">
                <% if (typeof user !=='undefined' && user) { %>
                    <div class="user-badge" title="<%= user.email %>">
                        <div class="user-avatar">
                            <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <span class="user-name-text">
                            <%= user.name %>
                        </span>
                    </div>
                    <a href="/auth/logout" class="btn btn-outline btn-sm">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline btn-sm">Login</a>
                    <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- Main Checkout Container -->
    <main class="checkout-container">

        <% 
            const cartItems = (typeof cart !== 'undefined' && cart && Array.isArray(cart.items))
                ? cart.items.filter(item => item && item.product)
                : [];

            let initialSubtotal = 0;
            let totalItemUnits = 0;

            cartItems.forEach(item => {
                const pPrice = Number(item.product.price) || 0;
                const pQty = Number(item.quantity) || 1;
                initialSubtotal += pPrice * pQty;
                totalItemUnits += pQty;
            });

            const initialShipping = initialSubtotal >= 1000 ? 0 : 50;
            const initialTotal = initialSubtotal > 0 ? (initialSubtotal + initialShipping) : 0;
        %>

        <!-- Page Header -->
        <section class="checkout-page-header">
            <div class="checkout-title-wrap">
                <nav class="back-nav" aria-label="Breadcrumb">
                    <a href="/cart" class="back-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Return to Cart
                    </a>
                </nav>
                <div class="checkout-heading-row">
                    <h1>Checkout</h1>
                    <span class="checkout-step-badge">Step 2 of 2</span>
                </div>
                <p class="checkout-subtitle">Enter your delivery address and review your order before placing it.</p>
            </div>
        </section>

        <!-- Active Checkout Layout (Shipping Form + Order Summary) -->
        <div id="checkoutActiveLayout" class="checkout-layout"
            style="<%= cartItems.length === 0 ? 'display: none;' : '' %>">

            <!-- Left Column: Shipping Form -->
            <section class="checkout-shipping-column" aria-label="Shipping Address">
                <div class="checkout-card shipping-card">
                    <div class="card-header-row">
                        <div class="card-header-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <div>
                            <h2>Shipping Information</h2>
                            <p class="card-header-subtitle">Where should we deliver your order?</p>
                        </div>
                    </div>

                    <!-- Alert message container for form/API errors -->
                    <div id="formErrorAlert" class="checkout-alert checkout-alert-error" style="display: none;" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span id="formErrorMessage">Please check the required fields.</span>
                    </div>

                    <form id="checkoutForm" novalidate autocomplete="on">
                        <!-- Full Name -->
                        <div class="form-group">
                            <label for="fullName">
                                Full Name <span class="required-star">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="fullName" 
                                name="fullName" 
                                value="<%= (typeof user !== 'undefined' && user && user.name) ? user.name : '' %>"
                                placeholder="e.g. Rahul Sharma" 
                                required 
                                autocomplete="name"
                            >
                            <span class="field-error" id="fullNameError"></span>
                        </div>

                        <!-- Phone -->
                        <div class="form-group">
                            <label for="phone">
                                Phone Number <span class="required-star">*</span>
                            </label>
                            <input 
                                type="tel" 
                                id="phone" 
                                name="phone" 
                                placeholder="e.g. 9876543210" 
                                required 
                                autocomplete="tel"
                            >
                            <span class="field-error" id="phoneError"></span>
                        </div>

                        <!-- Address Line -->
                        <div class="form-group">
                            <label for="addressLine">
                                Street Address / Flat / Building <span class="required-star">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="addressLine" 
                                name="addressLine" 
                                placeholder="House / Flat No., Building Name, Street, Area" 
                                required 
                                autocomplete="street-address"
                            >
                            <span class="field-error" id="addressLineError"></span>
                        </div>

                        <!-- City & State 2-Column Row -->
                        <div class="form-row-2">
                            <div class="form-group">
                                <label for="city">
                                    City <span class="required-star">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="city" 
                                    name="city" 
                                    placeholder="e.g. Mumbai" 
                                    required 
                                    autocomplete="address-level2"
                                >
                                <span class="field-error" id="cityError"></span>
                            </div>

                            <div class="form-group">
                                <label for="state">
                                    State <span class="required-star">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="state" 
                                    name="state" 
                                    placeholder="e.g. Maharashtra" 
                                    required 
                                    autocomplete="address-level1"
                                >
                                <span class="field-error" id="stateError"></span>
                            </div>
                        </div>

                        <!-- Postal Code & Country 2-Column Row -->
                        <div class="form-row-2">
                            <div class="form-group">
                                <label for="postalCode">
                                    Postal Code <span class="required-star">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="postalCode" 
                                    name="postalCode" 
                                    placeholder="e.g. 400001" 
                                    required 
                                    autocomplete="postal-code"
                                >
                                <span class="field-error" id="postalCodeError"></span>
                            </div>

                            <div class="form-group">
                                <label for="country">
                                    Country <span class="required-star">*</span>
                                </label>
                                <select id="country" name="country" required autocomplete="country-name">
                                    <option value="India" selected>India</option>
                                </select>
                                <span class="field-error" id="countryError"></span>
                            </div>
                        </div>

                        <!-- Form Helper Note -->
                        <div class="form-note">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <span>Please verify your shipping details carefully. We will use this information to dispatch your items.</span>
                        </div>
                    </form>
                </div>
            </section>

            <!-- Right Column: Order Summary -->
            <aside class="checkout-summary-column" aria-label="Order Summary">
                <div class="checkout-card summary-card">
                    <div class="summary-header">
                        <h2>Order Summary</h2>
                        <span class="summary-count-badge" id="checkoutCountBadge">
                            <%= totalItemUnits %> <%= totalItemUnits === 1 ? 'item' : 'items' %>
                        </span>
                    </div>

                    <!-- Items Review List -->
                    <div class="summary-items-list" id="checkoutItemsList">
                        <% cartItems.forEach(function(item) { %>
                            <% 
                                const product = item.product; 
                                const unitPrice = Number(product.price) || 0; 
                                const quantity = Number(item.quantity) || 1; 
                                const itemSubtotal = unitPrice * quantity; 
                            %>
                            <div class="summary-item" data-product-id="<%= product._id %>" data-price="<%= unitPrice %>" data-qty="<%= quantity %>">
                                <div class="summary-item-thumb">
                                    <% if (product.images && product.images.length > 0 && product.images[0]) { %>
                                        <img src="<%= product.images[0] %>" alt="<%= product.name %>" loading="lazy"
                                            onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'summary-thumb-placeholder\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.5\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><path d=\'M21 15l-5-5L5 21\'/></svg></div>';">
                                    <% } else { %>
                                        <div class="summary-thumb-placeholder">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                                <circle cx="8.5" cy="8.5" r="1.5" />
                                                <path d="M21 15l-5-5L5 21" />
                                            </svg>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="summary-item-details">
                                    <h3 class="summary-item-title" title="<%= product.name %>">
                                        <%= product.name %>
                                    </h3>
                                    <div class="summary-item-calc">
                                        <span class="summary-item-qty"><%= quantity %> ×</span>
                                        <span class="summary-item-unit-price">₹<%= unitPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                                    </div>
                                </div>
                                <div class="summary-item-subtotal">
                                    ₹<%= itemSubtotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <!-- Price Calculations -->
                    <div class="summary-totals">
                        <div class="totals-row">
                            <span>Subtotal</span>
                            <span id="summarySubtotal">
                                ₹<%= initialSubtotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                            </span>
                        </div>
                        <div class="totals-row">
                            <span>Shipping</span>
                            <span id="summaryShipping">
                                <% if (initialSubtotal >= 1000) { %>
                                    <span class="val-free">FREE</span>
                                <% } else { %>
                                    ₹50.00
                                <% } %>
                            </span>
                        </div>
                        <div class="totals-row total-row">
                            <span>Total</span>
                            <span class="total-amount" id="summaryTotal">
                                ₹<%= initialTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                            </span>
                        </div>
                    </div>

                    <!-- Action: Place Order Button -->
                    <div class="place-order-wrap">
                        <button type="button" class="btn btn-primary btn-block btn-place-order" id="placeOrderBtn">
                            <span class="btn-text">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                                Place Order
                            </span>
                            <span class="btn-loading" style="display: none;">
                                <span class="spinner"></span>
                                Placing Order...
                            </span>
                        </button>
                    </div>

                    <!-- Trust & Security Elements -->
                    <div class="checkout-trust-box">
                        <div class="trust-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                            <span>Safe & Secure Checkout</span>
                        </div>
                        <div class="trust-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>100% Genuine Products</span>
                        </div>
                        <div class="trust-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="1 4 1 10 7 10"></polyline>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                            </svg>
                            <span>Hassle-Free Returns</span>
                        </div>
                    </div>

                </div>
            </aside>

        </div>

        <!-- Empty Cart State -->
        <section id="emptyCartContainer" class="empty-checkout-card"
            style="<%= cartItems.length > 0 ? 'display: none;' : '' %>" aria-label="Empty Checkout Notice">
            <div class="empty-checkout-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                    stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </div>
            <h2>Your cart is empty</h2>
            <p>Add products to your cart before proceeding to checkout.</p>
            <a href="/products" class="btn btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Continue Shopping
            </a>
        </section>

    </main>

    <!-- Toast Notification Container -->
    <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

    <!-- Site Footer -->
    <footer class="app-footer">
        <p>&copy; <%= new Date().getFullYear() %> ShopPulse. All rights reserved.</p>
    </footer>

    <!-- Client-Side Checkout Controller -->
    <script src="/js/checkout.js"></script>

</body>

</html>
