<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Wishlist - ShopPulse</title>
    <meta name="description" content="View and manage your saved products in your ShopPulse wishlist. Add items directly to your cart or continue shopping.">
    <link rel="stylesheet" href="/css/wishlist.css">
</head>
<body>

    <!-- Header & Navigation -->
    <header class="app-header">
        <div class="header-container">
            <!-- Brand Logo -->
            <div class="brand-area">
                <a href="<%= (typeof user !== 'undefined' && user) ? '/dashboard' : '/products' %>" class="brand-logo" aria-label="ShopPulse Home">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                    </div>
                    <span>ShopPulse</span>
                </a>
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <span class="admin-tag">Admin</span>
                <% } %>
            </div>

            <!-- Navigation Links -->
            <nav aria-label="Main Navigation">
                <ul class="nav-links">
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <li class="nav-item"><a href="/dashboard">Dashboard</a></li>
                        <li class="nav-item"><a href="/products">Storefront</a></li>
                        <li class="nav-item"><a href="/admin/products">Products</a></li>
                    <% } else if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item"><a href="/dashboard">Home</a></li>
                        <li class="nav-item"><a href="/products">Products</a></li>
                        <li class="nav-item"><a href="/wishlist" class="active" aria-current="page">Wishlist</a></li>
                        <li class="nav-item"><a href="/orders">Orders</a></li>
                        <li class="nav-item"><a href="/cart">Cart</a></li>
                    <% } else { %>
                        <li class="nav-item"><a href="/products">Products</a></li>
                        <li class="nav-item"><a href="/wishlist" class="active" aria-current="page">Wishlist</a></li>
                        <li class="nav-item"><a href="/cart">Cart</a></li>
                    <% } %>
                </ul>
            </nav>

            <!-- User Profile / Auth Area -->
            <div class="header-user-area">
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="user-badge" title="<%= user.email %>">
                        <div class="user-avatar">
                            <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <span class="user-name-text"><%= user.name %></span>
                    </div>
                    <a href="/auth/logout" class="btn btn-outline btn-sm">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline btn-sm">Login</a>
                    <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- Main Wishlist Container -->
    <main class="wishlist-container">
        
        <%
            const wishlistProducts = (typeof wishlist !== 'undefined' && wishlist && Array.isArray(wishlist.products))
                ? wishlist.products.filter(product => product && product._id)
                : [];
            const count = wishlistProducts.length;
        %>

        <!-- Page Header -->
        <section class="wishlist-page-header">
            <div class="wishlist-title-wrap">
                <div class="wishlist-heading-row">
                    <h1>Your Wishlist</h1>
                    <span class="wishlist-count-badge" id="wishlistCountBadge">
                        <%= count %> <%= count === 1 ? 'saved item' : 'saved items' %>
                    </span>
                </div>
                <p class="wishlist-subtitle">Manage the products you've saved and move them to your cart whenever you're ready.</p>
            </div>
            <div class="wishlist-header-actions">
                <a href="/products" class="wishlist-continue-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    Continue Shopping
                </a>
            </div>
        </section>

        <!-- Active Wishlist Grid (Rendered when products exist) -->
        <div id="wishlistActiveLayout" class="wishlist-layout" style="<%= count === 0 ? 'display: none;' : '' %>">
            
            <section class="product-grid wishlist-grid" id="wishlistGrid" aria-label="Saved Products">
                <% wishlistProducts.forEach(function(product) { %>
                    <% 
                        const stockCount = Number(product.stock) || 0;
                        const formattedPrice = Number(product.price || 0).toLocaleString('en-IN', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                    %>
                    <article 
                        class="product-card wishlist-card" 
                        id="wishlist-item-<%= product._id %>"
                        data-product-id="<%= product._id %>"
                        data-product-name="<%= product.name %>"
                        data-price="<%= product.price || 0 %>"
                        data-stock="<%= stockCount %>"
                    >
                        <!-- Card Image Wrap with Remove Overlay Button -->
                        <div class="product-card-image-wrap">
                            <a href="/products/<%= product._id %>" class="product-image-link" aria-label="View <%= product.name %> details">
                                <% if (product.images && product.images.length > 0 && product.images[0]) { %>
                                    <img 
                                        src="<%= product.images[0] %>" 
                                        alt="<%= product.name %>" 
                                        class="product-card-image"
                                        loading="lazy"
                                        onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'product-card-placeholder\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.5\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><path d=\'M21 15l-5-5L5 21\'/></svg><span>No image available</span></div>';"
                                    >
                                <% } else { %>
                                    <div class="product-card-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                            <circle cx="8.5" cy="8.5" r="1.5"/>
                                            <path d="M21 15l-5-5L5 21"/>
                                        </svg>
                                        <span>No image available</span>
                                    </div>
                                <% } %>
                            </a>

                            <!-- Remove from Wishlist Button -->
                            <button 
                                type="button" 
                                class="btn-remove-wishlist" 
                                data-product-id="<%= product._id %>"
                                data-product-name="<%= product.name %>"
                                aria-label="Remove <%= product.name %> from wishlist"
                                title="Remove from wishlist"
                            >
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </div>

                        <!-- Card Body -->
                        <div class="product-card-body">
                            <!-- Category and Brand Badges -->
                            <div class="product-badges">
                                <% if (product.brand) { %>
                                    <span class="badge-tag badge-brand"><%= product.brand %></span>
                                <% } %>
                                <% if (product.category) { %>
                                    <span class="badge-tag"><%= product.category %></span>
                                <% } %>
                            </div>

                            <!-- Product Title -->
                            <h2 class="product-card-title">
                                <a href="/products/<%= product._id %>" title="<%= product.name %>"><%= product.name %></a>
                            </h2>

                            <!-- Card Footer: Price, Stock Badge, Add to Cart & Remove -->
                            <div class="product-card-footer">
                                <div class="product-pricing-stock">
                                    <span class="product-price">₹<%= formattedPrice %></span>

                                    <% if (stockCount > 0) { %>
                                        <span class="stock-badge in-stock">In Stock</span>
                                    <% } else { %>
                                        <span class="stock-badge out-of-stock">Out of Stock</span>
                                    <% } %>
                                </div>

                                <!-- Wishlist Card Actions -->
                                <div class="wishlist-card-actions">
                                    <button 
                                        type="button" 
                                        class="btn btn-primary btn-add-to-cart" 
                                        data-product-id="<%= product._id %>" 
                                        data-product-name="<%= product.name %>"
                                        <%= stockCount <= 0 ? 'disabled' : '' %>
                                        title="<%= stockCount <= 0 ? 'Product is currently out of stock' : 'Add to cart' %>"
                                    >
                                        <svg class="cart-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                        <span class="cart-btn-text"><%= stockCount > 0 ? 'Add to Cart' : 'Out of Stock' %></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </section>
        </div>

        <!-- Empty Wishlist State (Rendered when 0 products) -->
        <section 
            id="emptyWishlistContainer" 
            class="empty-state empty-wishlist-card" 
            style="<%= count > 0 ? 'display: none;' : '' %>"
            aria-label="Empty Wishlist Notification"
        >
            <div class="empty-icon empty-wishlist-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
            </div>
            <h2>Your Wishlist is Empty</h2>
            <p>Save products you love and find them here later.</p>
            <a href="/products" class="btn btn-primary btn-explore">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                Continue Shopping
            </a>
        </section>

    </main>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>

    <!-- Site Footer -->
    <footer class="app-footer">
        <p>&copy; <%= new Date().getFullYear() %> ShopPulse. All rights reserved.</p>
    </footer>

    <!-- Wishlist Interactions Controller -->
    <script src="/js/wishlist.js"></script>

</body>
</html>
