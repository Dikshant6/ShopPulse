<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products - ShopPulse</title>
    <link rel="stylesheet" href="/css/products.css">
</head>
<body>

    <!-- Header & Navigation -->
    <header class="app-header">
        <div class="header-container">
            <!-- Brand Logo -->
            <div class="brand-area">
                <a href="<%= (typeof user !== 'undefined' && user) ? '/dashboard' : '/products' %>" class="brand-logo" aria-label="ShopPulse Home">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                    </div>
                    <span>ShopPulse</span>
                </a>
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <span class="admin-tag">Admin</span>
                <% } %>
            </div>

            <!-- Navigation Links -->
            <nav>
                <ul class="nav-links">
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <li class="nav-item"><a href="/dashboard">Dashboard</a></li>
                        <li class="nav-item"><a href="/products" class="active">Storefront</a></li>
                        <li class="nav-item"><a href="/admin/products">Products</a></li>
                    <% } else if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item"><a href="/dashboard">Home</a></li>
                        <li class="nav-item"><a href="/products" class="active">Products</a></li>
                        <li class="nav-item"><a href="/orders">Orders</a></li>
                        <li class="nav-item"><a href="/cart">Cart</a></li>
                    <% } else { %>
                        <li class="nav-item"><a href="/products" class="active">Products</a></li>
                    <% } %>
                </ul>
            </nav>

            <!-- User Profile / Auth Area -->
            <div class="header-user-area">
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="user-badge" title="<%= user.email %>">
                        <div class="user-avatar">
                            <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <span class="user-name-text"><%= user.name %></span>
                    </div>
                    <a href="/auth/logout" class="btn btn-outline btn-sm">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline btn-sm">Login</a>
                    <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
                <% } %>
            </div>

        </div>
    </header>

    <!-- Main Products Container -->
    <main class="products-container">
        
        <!-- Page Header -->
        <section class="page-header">
            <h1>Explore Products</h1>
            <p>Browse our catalog of high-quality items available at great prices.</p>
        </section>

        <!-- Product Listing Content -->
        <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
            
            <!-- Storefront Toolbar: Search & Sort Controls -->
            <section class="storefront-toolbar" aria-label="Catalog Filters and Controls">
                <div class="toolbar-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input 
                        type="text" 
                        id="storefrontSearch" 
                        class="toolbar-search-input" 
                        placeholder="Search products by name, brand, or category..."
                        aria-label="Search catalog"
                        autocomplete="off"
                    >
                    <button type="button" class="toolbar-search-clear" id="toolbarSearchClear" aria-label="Clear search query" style="display: none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="toolbar-controls">
                    <div class="sort-control-group">
                        <label for="sortProductsSelect" class="sort-label">Sort by:</label>
                        <div class="sort-select-wrap">
                            <select id="sortProductsSelect" class="sort-select" aria-label="Sort products">
                                <option value="relevance">Relevance</option>
                                <option value="price-asc">Price: Low to High</option>
                                <option value="price-desc">Price: High to Low</option>
                                <option value="name-asc">Name: A to Z</option>
                                <option value="newest">Newest</option>
                            </select>
                            <svg class="sort-select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Meta Bar: Product Count & Admin Link -->
            <div class="products-meta-bar">
                <span class="products-count" id="productsCountBadge">
                    <%= products.length %> <%= products.length === 1 ? 'product' : 'products' %> found
                </span>
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <a href="/admin/products" class="btn btn-outline btn-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                        Product Management
                    </a>
                <% } %>
            </div>

            <!-- Product Grid -->
            <section class="product-grid" id="productGrid" aria-label="Product Catalog">
                <% products.forEach(function(product, index) { %>
                    <article 
                        class="product-card" 
                        data-id="<%= product._id %>"
                        data-name="<%= (product.name || '').toLowerCase() %>"
                        data-brand="<%= (product.brand || '').toLowerCase() %>"
                        data-category="<%= (product.category || '').toLowerCase() %>"
                        data-price="<%= product.price || 0 %>"
                        data-stock="<%= product.stock != null ? product.stock : 0 %>"
                        data-created="<%= product.createdAt ? new Date(product.createdAt).getTime() : 0 %>"
                        data-index="<%= index %>"
                    >
                        <!-- Product Image & Wishlist Button -->
                        <div class="product-card-image-wrap">
                            <a href="/products/<%= product._id %>" class="product-image-link" aria-label="View <%= product.name %> details">
                                <% if (product.images && product.images.length > 0 && product.images[0]) { %>
                                    <img 
                                        src="<%= product.images[0] %>" 
                                        alt="<%= product.name %>" 
                                        class="product-card-image"
                                        loading="lazy"
                                        onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'product-card-placeholder\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'1.5\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><path d=\'M21 15l-5-5L5 21\'/></svg><span>No image available</span></div>';"
                                    >
                                <% } else { %>
                                    <div class="product-card-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                            <circle cx="8.5" cy="8.5" r="1.5"/>
                                            <path d="M21 15l-5-5L5 21"/>
                                        </svg>
                                        <span>No image available</span>
                                    </div>
                                <% } %>
                            </a>

                            <!-- Wishlist Button -->
                            <button 
                                type="button" 
                                class="btn-wishlist" 
                                aria-label="Add <%= product.name %> to wishlist" 
                                aria-pressed="false"
                                data-product-id="<%= product._id %>"
                                title="Save to wishlist"
                            >
                                <svg class="wishlist-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                            </button>
                        </div>

                        <!-- Product Information Body -->
                        <div class="product-card-body">
                            <!-- Category and Brand Badges -->
                            <div class="product-badges">
                                <% if (product.brand) { %>
                                    <span class="badge-tag badge-brand"><%= product.brand %></span>
                                <% } %>
                                <% if (product.category) { %>
                                    <span class="badge-tag"><%= product.category %></span>
                                <% } %>
                            </div>

                            <!-- Product Title -->
                            <h2 class="product-card-title">
                                <a href="/products/<%= product._id %>" title="<%= product.name %>"><%= product.name %></a>
                            </h2>

                            <!-- Card Footer: Price, Stock, Quantity Selector, Add to Cart -->
                            <div class="product-card-footer">
                                <div class="product-pricing-stock">
                                    <span class="product-price">₹<%= Number(product.price || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>

                                    <% const stockCount = Number(product.stock) || 0; %>
                                    <% if (stockCount > 0) { %>
                                        <span class="stock-badge in-stock">In Stock</span>
                                    <% } else { %>
                                        <span class="stock-badge out-of-stock">Out of Stock</span>
                                    <% } %>
                                </div>

                                <!-- Quantity Selector & Add to Cart Controls -->
                                <div class="product-card-actions">
                                    <div class="qty-selector" aria-label="Quantity selector">
                                        <button 
                                            type="button" 
                                            class="qty-btn qty-minus" 
                                            aria-label="Decrease quantity" 
                                            <%= stockCount <= 0 ? 'disabled' : '' %>
                                            title="Decrease quantity"
                                        >
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                            </svg>
                                        </button>
                                        <input 
                                            type="number" 
                                            class="qty-input" 
                                            value="1" 
                                            min="1" 
                                            max="<%= stockCount > 0 ? stockCount : 1 %>" 
                                            aria-label="Product quantity" 
                                            <%= stockCount <= 0 ? 'disabled' : '' %>
                                            readonly
                                        >
                                        <button 
                                            type="button" 
                                            class="qty-btn qty-plus" 
                                            aria-label="Increase quantity" 
                                            <%= stockCount <= 0 ? 'disabled' : '' %>
                                            title="Increase quantity"
                                        >
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                            </svg>
                                        </button>
                                    </div>

                                    <button 
                                        type="button" 
                                        class="btn btn-primary btn-add-to-cart" 
                                        data-product-id="<%= product._id %>" 
                                        data-product-name="<%= product.name %>"
                                        <%= stockCount <= 0 ? 'disabled' : '' %>
                                    >
                                        <svg class="cart-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                        <span class="cart-btn-text"><%= stockCount > 0 ? 'Add to Cart' : 'Out of Stock' %></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </section>

            <!-- Search No Results State (Hidden by default, shown via JS when query matches nothing) -->
            <div id="noSearchResults" class="empty-state no-search-state" style="display: none;">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>
                <h3>No matching products found</h3>
                <p>We couldn't find any products matching your search. Try checking your spelling or using different keywords.</p>
                <button type="button" class="btn btn-outline" id="clearSearchBtn">Clear Search</button>
            </div>

        <% } else { %>
            <!-- Empty Catalog State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                </div>
                <h3>No products available</h3>
                <p>We couldn't find any products in our catalog right now. Please check back soon!</p>
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <a href="/admin/products/new" class="btn btn-primary">+ Add New Product</a>
                <% } else if (typeof user !== 'undefined' && user) { %>
                    <a href="/dashboard" class="btn btn-primary">Return Home</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-primary">Sign In</a>
                <% } %>
            </div>
        <% } %>

    </main>

    <!-- Footer -->
    <footer class="app-footer">
        <p>&copy; <%= new Date().getFullYear() %> ShopPulse. All rights reserved.</p>
    </footer>

    <!-- Storefront UI Interactions -->
    <script src="/js/products.js"></script>

</body>
</html>
