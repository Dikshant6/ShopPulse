<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShopPulse Email Verification</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f7; font-family:Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f7; padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
          <tr>
            <td style="background-color:#1a1a2e; padding:24px; text-align:center;">
              <span style="color:#ffffff; font-size:20px; font-weight:bold;">ShopPulse</span>
            </td>
          </tr>
          <tr>
            <td style="padding:32px 40px;">
              <h2 style="margin:0 0 12px; color:#1a1a2e; font-size:20px;">Verify your email</h2>
              <p style="margin:0 0 24px; color:#555555; font-size:14px; line-height:1.6;">
                Use the one-time code below to complete your verification. This code will expire in <%= expiryMinutes %> minutes.
              </p>
              <div style="text-align:center; margin:0 0 24px;">
                <span style="display:inline-block; padding:14px 28px; background-color:#f4f4f7; border-radius:6px; font-size:28px; font-weight:bold; letter-spacing:6px; color:#1a1a2e;">
                  <%= otp %>
                </span>
              </div>
              <p style="margin:0; color:#888888; font-size:13px; line-height:1.6;">
                If you didn't request this code, you can safely ignore this email.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 40px; background-color:#fafafa; text-align:center;">
              <p style="margin:0; color:#aaaaaa; font-size:12px;">&copy; <%= year %> ShopPulse. All rights reserved.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
